{
  "name": "sanad-monorepo",
  "version": "1.0.0",
  "description": "SANAD Platform Monorepo — Next.js Frontend & NestJS Backend with MySQL & Prisma",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:frontend": "npm --prefix frontend run test",
    "test:backend": "npm --prefix backend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f sanad-mysql",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:migrate": "npm --prefix backend run prisma:migrate:dev",
    "prisma:studio": "npm --prefix backend run prisma:studio"
  },
  "keywords": [
    "sanad",
    "hackathon",
    "nextjs",
    "nestjs",
    "mysql",
    "prisma",
    "ai",
    "gemini",
    "i18n",
    "rtl"
  ],
  "author": "SANAD Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  }
}
