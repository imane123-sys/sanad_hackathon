# ==========================================
# SANAD — Environment Configuration Template
# ==========================================

# --- Application Environments ---
NODE_ENV=development

# --- Database (MySQL in Docker) ---
DB_HOST=localhost
DB_PORT=3308
DB_NAME=sanad_db
DB_USER=sanad_app
DB_PASSWORD=sanad_secure_pass_2026
DB_ROOT_PASSWORD=root_sanad_secret

# Prisma Database Connection URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# --- Backend (NestJS) ---
BACKEND_PORT=4000
BACKEND_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000

# --- Frontend (Next.js) ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_AVAILABLE_LOCALES=ar,fr

# --- AI / LLM Configuration ---
# Supported providers: gemini | openai
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
AI_API_KEY=your_gemini_api_key_here
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048

# --- Authentication & JWT Configuration ---
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d
SESSION_IDLE_TIMEOUT_HOURS=24
THROTTLE_TTL=60
THROTTLE_LIMIT=20

