# ==========================================
# SANAD Backend — Environment Configuration
# ==========================================

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MySQL in Docker)
DB_HOST=localhost
DB_PORT=3308
DB_NAME=sanad_db
DB_USER=sanad_app
DB_PASSWORD=sanad_secure_pass_2026

# Prisma MySQL Database URL
DATABASE_URL="mysql://sanad_app:sanad_secure_pass_2026@localhost:3308/sanad_db"

# AI / LLM Configuration
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-pro
AI_API_KEY=your_gemini_api_key_here
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=2048

# Authentication & JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d
SESSION_IDLE_TIMEOUT_HOURS=24
THROTTLE_TTL=60
THROTTLE_LIMIT=20

